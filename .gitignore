# Dependencias
node_modules/

# Artefatos de build
# dist/ e a saida do Vite, regerada por `npm run build` antes do empacotamento.
# dist-electron/ e a saida do electron-builder (instaladores).
dist/
dist-electron/

# Banco local e backups gerados pelo script de conciliacao
*.db
*.db-shm
*.db-wal
*.db.bak-*

# Ambiente
.env
.env.*
!.env.example

# Ferramentas
.claude/
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Artefatos de depuracao (extracao de builds, logs de ativacao)
app-extracted*/
app-verify/
log*.txt

# Banco criado ao rodar db.js fora do Electron (testes e scripts)
tapedido.db
tapedido.db-wal
tapedido.db-shm
